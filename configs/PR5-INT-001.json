{
  "experiment_id": "PR5-INT-001",
  "purpose": "First real preliminary intent-only baseline for Progress Report V",
  "dataset": {
    "audit_path": "data/metadata/AUD-001.json",
    "audit_sha256": "6c87b2b77d859f087341e72c728a26dca2c9efc505b899741caef813c8bbdcb8",
    "archive_path": "data/raw/amazon-massive-dataset-1.0.tar.gz",
    "file_path": "data/raw/massive-1.0/az-AZ.jsonl",
    "license_path": "data/raw/massive-1.0/LICENSE",
    "release": "MASSIVE 1.0",
    "locale": "az-AZ",
    "train_partition": "train",
    "evaluation_partition": "dev",
    "input_field": "utt",
    "target_field": "intent"
  },
  "preprocessing": {
    "case": "preserve",
    "unicode_normalization": "none",
    "transliteration": false,
    "spelling_correction": false,
    "stemming": false,
    "duplicate_policy": "Preserve official splits and all records; report overlap diagnostically."
  },
  "vectorizer": {
    "analyzer": "char",
    "ngram_range": [3, 5],
    "lowercase": false,
    "strip_accents": null,
    "min_df": 1,
    "max_df": 1.0,
    "max_features": null,
    "sublinear_tf": true,
    "use_idf": true,
    "smooth_idf": true,
    "norm": "l2"
  },
  "classifier": {
    "solver": "lbfgs",
    "penalty": "l2",
    "C": 1.0,
    "tol": 0.0001,
    "max_iter": 1000,
    "fit_intercept": true,
    "class_weight": null,
    "random_state": 42
  },
  "seed": 42,
  "threads": 1,
  "majority_tie_break": "Lexicographically smallest label among tied train counts",
  "evaluation": {
    "metrics": ["accuracy", "macro_f1", "per_class_precision_recall_f1_support"],
    "macro_f1_labels": "All labels observed in official train (expected 60)",
    "zero_division": 0,
    "hyperparameter_search": false,
    "test_policy": "Structural validation only; never fit, tune, predict, or score test."
  },
  "smoke": {"train_per_class": 3, "dev_per_class": 1},
  "output_dir": "results/PR5-INT-001"
}
